{
  "name": "xingyu-blog",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#domain/*": "./domain/*.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1",
    "dev:production": "vinext dev --mode production --hostname 127.0.0.1",
    "build": "vinext build",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "start": "vinext start",
    "test": "npm run typecheck && npm run build && npm run types:worker:check && npm run test:provisioning && npm run test:source && npm run test:integration",
    "test:source": "node --test tests/instance-identity.test.mjs tests/rendered-html.test.mjs tests/oauth-auth.test.mjs tests/oauth-protocol.test.mjs tests/mcp-read.test.mjs tests/admin-reader-context.test.mjs tests/admin-activation.test.mjs tests/public-document-cache.test.mjs tests/media-response.test.mjs tests/public-read-session.test.mjs tests/document-blocks.test.mjs tests/identity-email.test.mjs tests/admin-design-reuse.test.mjs tests/connect-separation.test.mjs",
    "test:integration": "node --test tests/integration/instance-safety.test.mjs tests/integration/security-contracts.test.mjs tests/integration/schema-migrations.test.mjs tests/integration/post-write-contracts.test.mjs tests/integration/views-contracts.test.mjs tests/integration/read-session-contracts.test.mjs tests/integration/knowledge-import-contracts.test.mjs tests/integration/private-beta-safety-contracts.test.mjs tests/integration/workspace-isolation.test.mjs tests/integration/identity-verification.test.mjs tests/integration/identity-mcp-oauth.test.mjs tests/integration/identity-personal-pat.test.mjs tests/integration/identity-password-recovery.test.mjs tests/integration/workspace-collaboration.test.mjs tests/integration/organization-members-units.test.mjs tests/integration/team-workspace-acl.test.mjs",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run types:worker:check && npm run test:provisioning && npm run test:source && npm run test:integration",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types cloudflare-env.d.ts --config wrangler.production.jsonc --env-file .env.example --include-runtime=false --strict-vars=false",
    "types:worker:check": "npm run types:worker -- --check",
    "db:generate": "drizzle-kit generate",
    "test:provisioning": "node --test tests/beta-provisioning.test.mjs",
    "beta:prepare": "node scripts/beta-provision.mjs prepare",
    "beta:apply": "node scripts/beta-provision.mjs apply",
    "beta:verify": "node scripts/beta-provision.mjs verify",
    "beta:smoke": "node scripts/beta-provision.mjs smoke",
    "beta:decommission": "node scripts/beta-provision.mjs decommission"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "2.4.0",
    "agents": "^0.18.0",
    "drizzle-orm": "0.45.2",
    "mermaid": "^11.17.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-pageflip": "^2.0.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "vditor": "^3.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "puppeteer-core": "^25.12.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@hono/node-server": "2.0.11",
    "baseline-browser-mapping": "2.11.21",
    "dompurify": "3.4.15",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "miniflare": {
      "undici": "7.30.0"
    },
    "nanoid@3.3.16": "3.3.18",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "vinext": {
      "image-size": "2.0.4"
    }
  },
  "type": "module"
}
