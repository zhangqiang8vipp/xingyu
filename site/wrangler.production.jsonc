{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xingyu-blog",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "DB_SCHEMA_MODE": "migration-only",
    "CSP_MODE": "report-only"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xingyu-production-v2",
      "database_id": "ef27f3c6-349a-44ea-ae09-0cc9dccca691",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/[0-9][0-9][0-9][0-9]_*.sql"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xingyu-production-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "zhangwansen.click/*",
      "zone_name": "zhangwansen.click"
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
